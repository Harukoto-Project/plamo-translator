{
  "name": "plamo-translator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bindings": "cargo run -p plamo-translator --bin export-bindings --features export-bindings",
    "rust:fmt": "cargo fmt --all",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^27.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^18.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
